# Supabase project (Settings -> API in your Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional but recommended: GitHub personal access token.
# Without it, GitHub's API rate-limits you to ~10 requests/min.
# With a token (even with zero scopes selected), it jumps to 5,000/hr.
GITHUB_TOKEN=

# Required for the message engine. Comma-separate keys from multiple
# Google accounts to spread usage across their free-tier quotas:
# GEMINI_API_KEYS=key_from_account_1,key_from_account_2
GEMINI_API_KEYS=

# Product Hunt adapter — free dev token at api.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=

# Email verification — Hunter.io free tier (50/month, personal email OK for sign-up)
HUNTER_API_KEY=

# Gmail sending accounts for send_approved.py, comma-separated email:app_password pairs
GMAIL_ACCOUNTS=
